{
  "name": "sr-smith",
  "version": "1.0.0",
  "private": true,
  "description": "Sr.Smith 1.0 — plano de control local para ingeniería agéntica, independiente del proveedor, con runtime de referencia.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "smith": "./src/cli/index.ts",
    "dsh": "./src/cli/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "demo": "node --experimental-strip-types src/cli/index.ts demo",
    "check:architecture": "node --experimental-strip-types scripts/check-architecture.ts",
    "ai:sync": "python3 scripts/ai/sync-instructions.py",
    "ai:validate": "python3 scripts/ai/validate-config.py",
    "ai:context": "python3 scripts/ai/check-context.py"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
