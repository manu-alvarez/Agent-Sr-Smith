{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr-smith:schema:agents:agent-spec:1.0.0",
  "title": "AgentSpec",
  "description": "Qué es un agente, qué herramientas tiene y bajo qué límites. enabled false lo deja fuera del perfil.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Versión de contrato. Hoy solo 1.0.0."
    },
    "id": {
      "type": "string",
      "description": "Id estable, agt_<rol>.",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Nombre visible.",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "description": "Rol del catálogo.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Misión de una frase.",
      "minLength": 1
    },
    "model": {
      "description": "Proveedor y modelo. El runtime de referencia usa provider reference y modelId dsh-reference-1.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "Identificador del adaptador: reference, ollama, deepseek, openai, anthropic, google u openai-compatible.",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "description": "Id del modelo en ese proveedor. No implica que esté verificado.",
          "minLength": 1
        },
        "fallback": {
          "type": "array",
          "description": "Adaptadores a los que se puede caer si el primario falla. No se usan en strict-local.",
          "items": {
            "type": "string",
            "description": "Id de proveedor."
          }
        }
      },
      "required": [
        "provider",
        "modelId"
      ]
    },
    "capabilities": {
      "type": "array",
      "description": "Capacidades declaradas. No equivalen a verified.",
      "items": {
        "type": "string",
        "description": "Id de capacidad."
      }
    },
    "tools": {
      "type": "array",
      "description": "Nombres de herramientas nativas o de plugin.",
      "items": {
        "type": "string",
        "description": "Nombre de herramienta."
      }
    },
    "permissions": {
      "description": "Permisos de techo. La política puede denegar aunque el permiso sea true.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "description": "none no toca disco. workspace es el sandbox. restricted es un subconjunto declarado.",
          "enum": [
            "none",
            "workspace",
            "restricted"
          ]
        },
        "network": {
          "type": "boolean",
          "description": "True no abre red en strict-local."
        },
        "shell": {
          "type": "boolean",
          "description": "True no concede un shell fuera del sandbox."
        },
        "git": {
          "type": "boolean",
          "description": "True no crea commits por sí solo: git-write exige aprobación."
        }
      },
      "required": [
        "filesystem",
        "network",
        "shell",
        "git"
      ]
    },
    "limits": {
      "description": "Topes del agente, más estrechos que el presupuesto del perfil.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": {
          "type": "number",
          "description": "Pasos máximos.",
          "minimum": 1
        },
        "maxTokens": {
          "type": "number",
          "description": "Tope de tokens si hay un modelo. El runtime de referencia no los consume.",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "number",
          "description": "Tiempo máximo.",
          "minimum": 1
        },
        "maxToolCalls": {
          "type": "number",
          "description": "Llamadas a herramientas.",
          "minimum": 0
        }
      },
      "required": [
        "maxSteps",
        "timeoutMs",
        "maxToolCalls"
      ]
    },
    "policies": {
      "type": "array",
      "description": "Ids de política. La de serie es pol_default_autonomy.",
      "items": {
        "type": "string",
        "description": "Id de política.",
        "minLength": 1
      },
      "minItems": 1
    },
    "promptRef": {
      "type": "string",
      "description": "Ruta del prompt, relativa a la raíz del paquete.",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean",
      "description": "False excluye al agente de la delegación."
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "role",
    "description",
    "model",
    "capabilities",
    "tools",
    "permissions",
    "limits",
    "policies",
    "promptRef",
    "enabled"
  ],
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "id": "agt_developer",
      "name": "Developer",
      "role": "developer",
      "description": "Materializa el cambio dentro del sandbox.",
      "model": {
        "provider": "reference",
        "modelId": "dsh-reference-1",
        "fallback": [
          "ollama"
        ]
      },
      "capabilities": [
        "implementation"
      ],
      "tools": [
        "workspace.write"
      ],
      "permissions": {
        "filesystem": "workspace",
        "network": false,
        "shell": false,
        "git": false
      },
      "limits": {
        "maxSteps": 8,
        "maxTokens": 4096,
        "timeoutMs": 120000,
        "maxToolCalls": 12
      },
      "policies": [
        "pol_default_autonomy"
      ],
      "promptRef": "prompts/specialists/developer.md",
      "enabled": true
    }
  ]
}
