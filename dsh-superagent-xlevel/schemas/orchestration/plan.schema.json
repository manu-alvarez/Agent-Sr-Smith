{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr-smith:schema:orchestration:plan:1.0.0",
  "title": "Plan",
  "description": "Plan jerárquico. tasks es la lista completa, no solo ids. El grafo se deriva de dependencies y debe ser acíclico.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Versión de contrato. Hoy solo 1.0.0."
    },
    "id": {
      "type": "string",
      "description": "Id del plan.",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "description": "Proyecto.",
      "minLength": 1
    },
    "profileId": {
      "description": "Perfil que limita roles, herramientas y presupuesto.",
      "enum": [
        "research",
        "engineering",
        "autonomous",
        "security",
        "full",
        "headless"
      ]
    },
    "objective": {
      "type": "string",
      "description": "Objetivo literal del operador. Puede estar vacío solo en el rechazo previo al plan."
    },
    "summary": {
      "type": "string",
      "description": "Resumen que el planner deriva del objetivo.",
      "minLength": 1
    },
    "successCriteria": {
      "type": "array",
      "description": "Criterios del plan, además de los de cada tarea.",
      "items": {
        "type": "string",
        "description": "Criterio.",
        "minLength": 1
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "description": "Supuestos que el objetivo sostiene. No se inventan huecos.",
      "items": {
        "type": "string",
        "description": "Supuesto."
      }
    },
    "nonGoals": {
      "type": "array",
      "description": "Lo que este plan no va a hacer.",
      "items": {
        "type": "string",
        "description": "No-objetivo."
      }
    },
    "risks": {
      "type": "array",
      "description": "Riesgos visibles antes de ejecutar.",
      "items": {
        "type": "string",
        "description": "Riesgo."
      }
    },
    "tasks": {
      "type": "array",
      "description": "Tareas completas, en orden de declaración.",
      "items": {
        "description": "Misma forma que Task.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": "1.0.0",
            "description": "Versión de contrato. Hoy solo 1.0.0."
          },
          "id": {
            "type": "string",
            "description": "Identificador de la tarea.",
            "minLength": 1
          },
          "parentId": {
            "type": "string",
            "description": "Tarea padre si la descomposición es jerárquica."
          },
          "projectId": {
            "type": "string",
            "description": "Proyecto al que pertenece el plan.",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "Tipo de trabajo: design, implement, test, review, research u otro rol del plan.",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "description": "Título corto visible en el grafo.",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Qué hay que producir.",
            "minLength": 1
          },
          "assignedRole": {
            "type": "string",
            "description": "Rol del catálogo, por ejemplo developer o reviewer."
          },
          "assignedAgentId": {
            "type": "string",
            "description": "Id del agente, normalmente agt_<rol>."
          },
          "dependencies": {
            "type": "array",
            "description": "Ids de tareas que deben estar completed antes de que esta pase a ready.",
            "items": {
              "type": "string",
              "description": "Id de tarea."
            }
          },
          "status": {
            "description": "Estado de la tarea dentro del grafo.",
            "enum": [
              "pending",
              "ready",
              "running",
              "blocked",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "acceptanceCriteria": {
            "type": "array",
            "description": "Criterios observables. Cada uno necesita evidencia independiente.",
            "items": {
              "type": "string",
              "description": "Un criterio comprobable.",
              "minLength": 1
            },
            "minItems": 1
          },
          "inputs": {
            "description": "Entradas estructuradas. Puede estar vacío.",
            "type": "object",
            "additionalProperties": true,
            "properties": {}
          },
          "outputs": {
            "description": "Salidas producidas. Ausente hasta que la tarea termina.",
            "type": "object",
            "additionalProperties": true,
            "properties": {}
          },
          "budget": {
            "description": "Presupuesto de una tarea. Agotarlo bloquea; no se convierte en éxito.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxSteps": {
                "type": "number",
                "description": "Pasos de orquestación permitidos para esta tarea.",
                "minimum": 1
              },
              "timeoutMs": {
                "type": "number",
                "description": "Tiempo máximo en milisegundos.",
                "minimum": 1
              },
              "maxRetries": {
                "type": "number",
                "description": "Reintentos de una acción idempotente. Un borrado no se reintenta.",
                "minimum": 0
              }
            },
            "required": [
              "maxSteps",
              "timeoutMs",
              "maxRetries"
            ]
          },
          "attempts": {
            "type": "number",
            "description": "Intentos ya consumidos.",
            "minimum": 0
          },
          "requiresApproval": {
            "type": "boolean",
            "description": "True si la operación es git-write, red en local-runtime o production-change."
          },
          "operation": {
            "description": "Clase de operación que la política puede permitir, denegar o mandar a aprobación.",
            "enum": [
              "analyze",
              "sandbox-read",
              "sandbox-write",
              "test",
              "git-write",
              "network",
              "secrets",
              "external-delete",
              "production-change"
            ]
          },
          "blockedReason": {
            "type": "string",
            "description": "Motivo si status es blocked. Vacío o ausente en el resto."
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "projectId",
          "type",
          "title",
          "description",
          "dependencies",
          "status",
          "acceptanceCriteria",
          "inputs",
          "budget",
          "attempts",
          "requiresApproval",
          "operation"
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "description": "Instante ISO-8601 UTC, con zona o sufijo Z.",
      "minLength": 20
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "profileId",
    "objective",
    "summary",
    "successCriteria",
    "assumptions",
    "nonGoals",
    "risks",
    "tasks",
    "createdAt"
  ],
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "id": "pln_demo",
      "projectId": "prj_local",
      "profileId": "engineering",
      "objective": "Implement a checksummed checkpoint inside the local sandbox.",
      "summary": "Checkpoint local con verificación.",
      "successCriteria": [
        "Cada criterio de tarea tiene evidencia."
      ],
      "assumptions": [
        "El sandbox virtual es el único disco escribible."
      ],
      "nonGoals": [
        "No se publica en un remoto."
      ],
      "risks": [
        "Un checksum inestable impide reanudar."
      ],
      "tasks": [
        {
          "schemaVersion": "1.0.0",
          "id": "tsk_checkpoint",
          "projectId": "prj_local",
          "type": "implement",
          "title": "Checkpoint con checksum",
          "description": "Persistir el estado y comprobar el checksum antes de reanudar.",
          "assignedRole": "developer",
          "dependencies": [],
          "status": "completed",
          "acceptanceCriteria": [
            "El checksum del checkpoint coincide al restaurar."
          ],
          "inputs": {
            "path": "sandbox/checkpoint.json"
          },
          "budget": {
            "maxSteps": 8,
            "timeoutMs": 120000,
            "maxRetries": 1
          },
          "attempts": 1,
          "requiresApproval": false,
          "operation": "sandbox-write"
        }
      ],
      "createdAt": "2026-11-07T08:00:00.000Z"
    }
  ]
}
