{
  "schemaVersion": "1.0.0",
  "id": "headless",
  "name": "Headless X",
  "summary": "El mismo ciclo, pensado para CLI sin interfaz.",
  "policy": "pol_default_autonomy",
  "modeDefault": "strict-local",
  "roles": [
    "planner",
    "developer",
    "qa-engineer",
    "evaluator",
    "watchdog"
  ],
  "tools": [
    "workspace.read",
    "workspace.write"
  ],
  "capabilities": [
    "cli",
    "verification"
  ],
  "limits": {
    "maxSteps": 24,
    "maxParallel": 2,
    "timeoutMs": 180000
  }
}
