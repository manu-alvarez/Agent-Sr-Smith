{
  "schemaVersion": "1.0.0",
  "id": "research",
  "name": "Research X",
  "summary": "Investiga un tema, cita lo que encuentra y no escribe el programa hasta que la pregunta esté respondida.",
  "policy": "pol_default_autonomy",
  "modeDefault": "strict-local",
  "roles": [
    "planner",
    "researcher",
    "knowledge-engineer",
    "evaluator",
    "watchdog"
  ],
  "tools": [
    "knowledge.search",
    "memory.recall",
    "memory.remember"
  ],
  "capabilities": [
    "research",
    "citation",
    "synthesis"
  ],
  "limits": {
    "maxSteps": 24,
    "maxParallel": 3,
    "timeoutMs": 180000
  }
}
