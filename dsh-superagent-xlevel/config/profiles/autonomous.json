{
  "schemaVersion": "1.0.0",
  "id": "autonomous",
  "name": "Autonomous X",
  "summary": "Sigue una tarea larga, guarda el avance y retoma si el proceso se corta.",
  "policy": "pol_default_autonomy",
  "modeDefault": "strict-local",
  "roles": [
    "orchestrator",
    "planner",
    "developer",
    "qa-engineer",
    "watchdog",
    "recovery-agent",
    "evaluator"
  ],
  "tools": [
    "workspace.read",
    "workspace.write",
    "memory.remember"
  ],
  "capabilities": [
    "checkpoint",
    "recovery",
    "long-running"
  ],
  "limits": {
    "maxSteps": 48,
    "maxParallel": 4,
    "timeoutMs": 300000
  }
}
