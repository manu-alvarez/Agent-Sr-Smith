{
  "schemaVersion": "1.0.0",
  "mode": "local-runtime",
  "allowNetworkInference": false,
  "networkEffect": "require-approval",
  "httpHost": "127.0.0.1",
  "referenceProvider": "reference",
  "referenceModel": "dsh-reference-1",
  "automaticOperations": [
    "analyze",
    "sandbox-read",
    "sandbox-write",
    "test"
  ],
  "approvalOperations": [
    "git-write",
    "network",
    "production-change"
  ],
  "deniedOperations": [
    "secrets",
    "external-delete"
  ],
  "note": "La inferencia remota no se abre sola. Hace falta aprobación y un adaptador con credencial. Si falta la credencial, la llamada falla."
}
