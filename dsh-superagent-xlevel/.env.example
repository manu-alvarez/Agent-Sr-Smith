# No pongas secretos reales en este archivo.
# SMITH_* tiene prioridad. DSH_* se acepta como alias.
SMITH_MODE=strict-local
SMITH_PROFILE=engineering
SMITH_DATA_DIR=.dsh
SMITH_HOST=127.0.0.1
SMITH_PORT=8787
# SMITH_DEEPSEEK_API_KEY y SMITH_OPENAI_API_KEY no las lee ningún adaptador.
# Dejarlas comentadas. Escribirlas aquí no activa el proveedor ni lo marca verified.
# SMITH_DEEPSEEK_API_KEY=
# SMITH_OPENAI_API_KEY=
